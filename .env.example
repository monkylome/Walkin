# Copy to .env.local and fill in.

# Google Maps JS API key — used by the map view (app/components/map-view.tsx).
# Exposed to the browser, so restrict it by HTTP referrer in the Cloud console.
NEXT_PUBLIC_GOOGLE_MAPS_KEY=

# Gemini API key — used server-side by the AI search route (app/api/ai-search/route.ts).
# Get one at https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=
